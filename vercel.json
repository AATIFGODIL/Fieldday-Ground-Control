{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "EXPO_PUBLIC_API_URL=/api npx expo export -p web",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    },
    "api/voice.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,dist/**,assets/**,src/**,server/**,.expo/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|_expo/|assets/)[^.]*)",
      "destination": "/index.html"
    }
  ]
}
